# Self-hosted Node.js runtime only. Cloudflare continues to use .dev.vars/secrets.
DIARY_LOGIN=maxim
DIARY_PASSWORD=replace-with-your-own-password
DIARY_ACTION_SECRET=replace-with-a-random-signing-secret
DATABASE_PATH=./data/my-meds.sqlite
PORT=3000
APP_HOST=127.0.0.1
# Behind Caddy/Nginx, set this to your actual domain (no https:// prefix).
# It enables trusted forwarded HTTPS/host headers for the configured domain.
# VINEXT_TRUSTED_HOSTS=meds.example.com
