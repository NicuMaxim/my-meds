{
  "name": "my-meds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A personal medication tracker with daily schedules, dose checklists, and English/Russian language support.",
  "author": "Maxim Nicu",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:selfhost": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config vite.selfhost.config.ts --host 127.0.0.1",
    "build:selfhost": "node scripts/clean-build.mjs && vite build --config vite.selfhost.config.ts && node scripts/check-runtime.mjs node",
    "start:selfhost": "node --env-file-if-exists=.env scripts/start-selfhost.mjs",
    "db:migrate:selfhost": "node --env-file-if-exists=.env scripts/migrate-sqlite.mjs",
    "build": "node scripts/clean-build.mjs && vite build && node scripts/check-runtime.mjs cloudflare",
    "preview": "wrangler dev --config dist/server/wrangler.json --local --ip 127.0.0.1 --inspector-port 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:selfhost": "node --test tests/integration/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply my-meds --local --config wrangler.cloudflare.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply my-meds --remote --config wrangler.cloudflare.jsonc",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
